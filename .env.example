# Copy to .env and adjust. All values are optional — defaults target local servers.

# General (e.g. BM25 stemming and stopwords)
LANGUAGE=italian

# Generation (Ollama endpoint by default)
LLM_URL=http://localhost:11434/api/chat
LLM_MODEL=qwen2.5:7b
SYSTEM_PROMPT_PATH=data/prompts/system_prompt.md

# Embedding
EMBED_MODEL=BAAI/bge-m3

# Retrieval depths
TOP_I=20
TOP_K=10
TOP_N=5

# Ingestion paths
IN_DIR=data/raw
OUT_DIR=data/out
