# Copy to .env and adjust. All values are optional — defaults target local servers.

# General (e.g. BM25 stemming and stopwords)
LANGUAGE=italian

# Generation (Ollama endpoint by default)
LLM_URL=http://localhost:11434/api/chat
LLM_MODEL=qwen2.5:7b
SYSTEM_PROMPT_PATH=prompts/system_prompt.md

# Embedding
EMBED_MODEL=BAAI/bge-m3

# Vector store
VECTOR_STORE_COLLECTION=data
# persistent tier only:
VECTOR_STORE_PATH=./data/db/vector
# remote tier only:
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=

# Ingestion paths
DATA_DIR=data/raw
OUT_DIR=data/out
