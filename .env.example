# Copy to .env and adjust. All values are optional — defaults target local servers.

# General (e.g. BM25 stemming and stopwords)
LANGUAGE=italian

# Generation (Ollama endpoint by default)
LLM_URL=http://localhost:11434/api/chat
LLM_MODEL=qwen2.5:7b
SYSTEM_PROMPT_PATH=data/prompts/system_prompt.md

# Embedding
EMBED_MODEL=BAAI/bge-m3

# Retrieval depths
TOP_I=20
TOP_K=10
TOP_N=5

# Ingestion paths
IN_DIR=data/raw
OUT_DIR=data/out

# Authorization (ABAC)
# Leave the schema unset for a deployment without access control: nothing labels, nothing
# filters, retrieval returns everything. Setting it turns ABAC on, and from then on every
# retrieval must carry a filter.
# ACCESS_SCHEMA_PATH=data/access_schema.json
# Where the access attributes of local documents are curated, for a corpus with no producer
# upstream. Unset means they are expected to arrive with the documents.
# ACCESS_MANIFEST_PATH=data/access_manifest.json
